{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fff-api",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fff",
    "database_id": "55f0bf10-f695-45b9-b743-2c293fdf7224",
    "migrations_dir": "cloudflare/migrations"
  }],
  "r2_buckets": [{ "binding": "ARTWORK", "bucket_name": "fff-artwork" }],
  "send_email": [{ "name": "RANKING_EMAIL", "allowed_sender_addresses": ["troy@nissen.nexus"], "remote": false }],
  "triggers": { "crons": ["0 2 * * 3", "0 1 * * 3"] },
  "vars": {
    "APP_ORIGIN": "https://wirewednesday.nissen.nexus",
    "RANKING_REMINDERS_ENABLED": "false"
  },
  "routes": [
    {
      "pattern": "wirewednesday.nissen.nexus",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "build": {
    "command": "node cloudflare/scripts/prepare-assets.mjs"
  }
}
